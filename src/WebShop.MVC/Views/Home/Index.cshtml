@using WebShop.Core.Entities
@{
    ViewData["Title"] = "Home Page";
}
@{
    ViewBag.HideHeaderBottom = true;
}
@model HomeViewModel
<div class="container mb-30 index-page">
    <div class="row flex-row-reverse">
        <div class="row flex-row-reverse">
            <div class="col-lg-4-5">
                <section class="product-tabs section-padding position-relative">
                    <div class="section-title style-2">
                        <h3>Products</h3>
                    </div>
                    <!--End nav-tabs--> 
                    <div class="tab-content" id="myTabContent">
                        <div class="tab-pane fade show active" id="tab-one" role="tabpanel" aria-labelledby="tab-one">
                            <div class="row product-grid-4">
                                @foreach (var product in Model.Products)
                                {
                                    <div class="col-lg-1-5 col-md-4 col-12 col-sm-6">
                                        <div class="product-cart-wrap mb-30">
                                            <div class="product-img-action-wrap">
                                                <div class="product-img product-img-zoom">
                                                    <a asp-controller="Product"
                                                       asp-action="Details"
                                                       asp-route-id="@product.Id">
                                                        <img class="default-img" src="~/assets/imgs/shop/@product.ImageUrl" alt="@product.ProductName" />
                                                        <img class="hover-img" src="~/assets/imgs/shop/@product.ImageUrl" alt="@product.ProductName" />
                                                    </a>
                                                </div>
                                                <div class="product-action-1" style="display: flex; gap: 5px;">
                                                    <a aria-label="Add To Wishlist" href="javascript:void(0)" class="action-btn wishlist-btn" data-product-id="@product.Id">
                                                        <i class="fi-rs-heart"></i>
                                                    </a>
                                                    <a aria-label="Compare" class="action-btn" href="shop-compare.html"><i class="fi-rs-shuffle"></i></a>
                                                    <a aria-label="Quick view" class="action-btn" data-bs-toggle="modal" data-bs-target="#quickViewModal"><i class="fi-rs-eye"></i></a>
                                                </div>
                                                <div class="product-badges product-badges-position product-badges-mrg">
                                                    <span class="badge @GetBadgeClass(product.Badge)">
                                                        @GetBadgeText(product.Badge)
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="product-content-wrap">
                                                <div class="product-category">
                                                    <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@product.CategoryId">
                                                        @product.CategoryName
                                                    </a>
                                                </div>

                                                <h2>
                                                    <a asp-controller="Product"
                                                       asp-action="Details"
                                                       asp-route-id="@product.Id">
                                                        @product.ProductName
                                                    </a>
                                                </h2>
                                                <div class="product-rate-cover">
                                                    <div class="product-rate d-inline-block">
                                                        <div class="product-rating" style="width: 90%"></div>
                                                    </div>
                                                    <span class="font-small ml-5 text-muted"> (4.0)</span>
                                                </div>
                                                <div>
                                                    <span class="font-small text-muted">By <a href="vendor-details-1.html">NestFood</a></span>
                                                </div>
                                                <div class="product-card-bottom">
                                                    <div class="product-price">
                                                        <span>@(product.Price / 2)</span>
                                                        <span class="old-price">@product.Price</span>
                                                    </div>
                                                    <div class="add-cart">
                                                        <a class="add-cart-btn add" data-product-id="@product.Id" data-product-name="@product.ProductName">
                                                            <i class="fi-rs-shopping-cart mr-5"></i>Add
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <!--end product card-->
                            </div>
                            <!--End product-grid-4-->
                        </div>
                        <!--En tab one-->
                    </div>
                    <!--End tab-content-->
                </section>
                <!--Products Tabs-->
            </div>
            <div class="col-lg-1-5 primary-sidebar sticky-sidebar pt-30">
                <div class="sidebar-widget widget-category-2 mb-30">
                    <h5 class="section-title style-1 mb-30">Category</h5>
                    <ul>
                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                <img src="~/assets/imgs/theme/icons/category-1.svg" alt="" />
                                All Categories
                            </a>
                        </li>

                        @foreach (var category in Model.Categories)
                        {
                            <li>
                                <a asp-controller="Home"
                                   asp-action="Index"
                                   asp-route-categoryId="@category.CategoryId">
                                    <img src="~/assets/imgs/theme/icons/category-1.svg" alt="" />
                                    @category.CategoryName
                                </a>

                                <span class="count">
                                    @Model.Products.Count(p => p.CategoryId == category.CategoryId)
                                </span>
                            </li>
                        }
                    </ul>
                </div>

                <form method="get" asp-controller="Home" asp-action="Index">
                    <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />

                    <div class="sidebar-widget price_range range mb-30">
                        <h5 class="section-title style-1 mb-30">Filter by price</h5>

                        <div class="mb-10">
                            <label>Min Price</label>
                            <input type="number" min="0" name="minPrice" class="form-control"
                                   step="10" value="@Model.MinPrice" />
                        </div>

                        <div class="mb-10">
                            <label>Max Price</label>
                            <input type="number" min="0" name="maxPrice" class="form-control"
                                   step="10" value="@Model.MaxPrice" />
                        </div>

                        <div class="d-flex justify-content-center gap-3 mt-10">

                            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">
                                <i class="fi-rs-filter mr-5"></i> Filter
                            </button>

                            <a asp-controller="Home"
                               asp-action="Index"
                               asp-route-categoryId="@Model.SelectedCategoryId"
                               class="btn btn-sm btn-outline-secondary btn-primary rounded-pill px-3">
                                <i class="fi-rs-refresh mr-5"></i> Reset
                            </a>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetBadgeClass(Badge badge) => badge switch
    {
        Badge.FreeShipping => "bg-primary",
        Badge.Sale => "bg-primary",
        Badge.New => "bg-success",
        Badge.Hot => "bg-danger",
        _ => "bg-light text-dark"
    };

    string GetBadgeText(Badge badge) => badge switch
    {
        Badge.FreeShipping => "Free Shipping",
        Badge.Sale => "Sale",
        Badge.New => "New",
        Badge.Hot => "Hot",
        _ => ""
    };
}

@section Scripts {
    <script src="~/assets/js/cart-add.js"></script>
    <script src="~/assets/js/index-wishlist-fun.js"></script>
}

