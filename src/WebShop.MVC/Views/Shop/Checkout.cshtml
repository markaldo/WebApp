@model WebShop.MVC.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    var cartItems = ViewBag.CartItems as IEnumerable<WebShop.Core.Entities.CartItem>;
}

<div class="container mb-80 mt-50">
    <div class="row">
        <div class="col-lg-8 mb-40">
            <h1 class="heading-2 mb-10">Checkout</h1>
            <div class="d-flex justify-content-between">
                <h6 class="text-body">
                    There are <span class="text-brand">@Model.ItemCount</span> products in your cart
                </h6>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-7">
            <div class="row mb-50">
                <div class="col-lg-6 mb-sm-15 mb-lg-0 mb-md-3">
                    <div class="toggle_info">
                        <span><i class="fi-rs-user mr-10"></i><span class="text-muted font-lg">Already have an account?</span> <a href="#loginform" data-bs-toggle="collapse" class="collapsed font-lg" aria-expanded="false">Click here to login</a></span>
                    </div>
                    <div class="panel-collapse collapse login_form" id="loginform">
                        <div class="panel-body">
                            <p class="mb-30 font-sm">If you have shopped with us before, please enter your details below. If you are a new customer, please proceed to the Billing &amp; Shipping section.</p>
                            <!-- login form -->
                            <form id="loginCheckoutForm" method="post">
                                @Html.AntiForgeryToken()

                                <div class="form-group">
                                    <input type="email" name="Email" class="form-control" placeholder="Username Or Email" required />
                                </div>

                                <div class="form-group">
                                    <input type="password" name="Password" class="form-control" placeholder="Password" required />
                                </div>

                                <div class="login_footer form-group">
                                    <div class="chek-form">
                                        <div class="custome-checkbox">
                                            <input class="form-check-input" type="checkbox" name="RememberMe" id="remember" value="true" />
                                            <label class="form-check-label" for="remember">
                                                <span>Remember me</span>
                                            </label>
                                        </div>
                                    </div>
                                    <a href="#">Forgot password?</a>
                                </div>

                                <div class="form-group">
                                    <button type="submit" class="btn btn-md">Log in</button>
                                </div>
                            </form>

                            <!-- Loading spinner -->
                            <div id="loginLoading" class="text-center" style="display: none;">
                                <div class="spinner-border" role="status"></div>
                                <p>Logging in...</p>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <form method="post" class="apply-coupon">
                        <input type="text" placeholder="Enter Coupon Code...">
                        <button class="btn btn-md" name="login">Apply Coupon</button>
                    </form>
                </div>
            </div>
            <div class="row">
                <form asp-action="Checkout" method="post" id="checkoutForm">
                    @Html.AntiForgeryToken()

                    <!-- Billing Information -->
                    <div class="border p-40 border-radius-15 mb-30">
                        <h4 class="mb-10">Billing Information</h4>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <input asp-for="FirstName" class="form-control" placeholder="First Name" required />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <input asp-for="LastName" class="form-control" placeholder="Last Name" required />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                                    {
                                        <input asp-for="Email" class="form-control" type="email" placeholder="Email" required disabled/>
                                        <input type="hidden" asp-for="Email" hidden/>
                                    }
                                    else
                                    {
                                        <input asp-for="Email" class="form-control" type="email" placeholder="Email" required />
                                    }
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <input asp-for="Phone" class="form-control" placeholder="Phone Number" />
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Shipping Address -->
                    <div class="border p-40 border-radius-15">
                        <h4 class="mb-10">Shipping Address</h4>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    @if (Model.HasSavedAddress)
                                    {
                                        <input asp-for="AddressLine1" class="form-control" disabled />
                                        <input type="hidden" asp-for="AddressLine1" />
                                    }
                                    else
                                    {
                                        <input asp-for="AddressLine1" class="form-control" placeholder="House number and street" required />
                                    }
                                    <span asp-validation-for="AddressLine1" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    @if (Model.HasSavedAddress)
                                    {
                                        <input asp-for="AddressLine2" class="form-control" disabled />
                                        <input type="hidden" asp-for="AddressLine2" />
                                    }
                                    else
                                    {
                                        <input asp-for="AddressLine2" class="form-control" placeholder="House number and street" required />
                                    }
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-group">
                                    
                                    @if (Model.HasSavedAddress)
                                    {
                                        <input asp-for="City" class="form-control" disabled />
                                        <input type="hidden" asp-for="City" />
                                    }
                                    else
                                    {
                                        <input asp-for="City" class="form-control" placeholder="City" required />
                                    }
                                    <span asp-validation-for="City" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-group">
                                    @if (Model.HasSavedAddress)
                                    {
                                        <input asp-for="PostalCode" class="form-control" disabled />
                                        <input type="hidden" asp-for="PostalCode" />
                                    }
                                    else
                                    {
                                        <input asp-for="PostalCode" class="form-control" placeholder="Postal Code / ZIP" required />
                                    }
                                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-group">
                                    @if (Model.HasSavedAddress)
                                    {
                                        <input asp-for="Country" class="form-control" disabled />
                                        <input type="hidden" asp-for="Country" />
                                    }
                                    else
                                    {
                                        <input asp-for="Country" class="form-control" value="Poland" required />
                                    }
                                    <span asp-validation-for="Country" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group mb-30">
                                <textarea rows="5" asp-for="AdditionalInfo" class="form-control" placeholder="Additional information"></textarea>
                            </div>
                            <input type="hidden" asp-for="HasSavedAddress" />
                            
                            @if (User.Identity != null && User.Identity.IsAuthenticated && !Model.HasSavedAddress)
                            {
                                <div class="form-group">
                                    <div class="chek-form">
                                        <div class="custome-checkbox">
                                            <input asp-for="SaveAddress" class="form-check-input" type="checkbox" name="checkbox">
                                            <label asp-for="SaveAddress" class="form-check-label label_info"><span>Save address?</span></label>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-lg-5">
            <div class="border p-40 cart-totals ml-30 mb-50">
                <div class="d-flex align-items-end justify-content-between mb-30">
                    <h4>Your Order</h4>
                    <h6 class="text-muted">Subtotal</h6>
                </div>
                <div class="divider-2 mb-30"></div>
                <div class="table-responsive order_table checkout">
                    <table class="table no-border">
                        <tbody>
                            @foreach (var item in cartItems ?? new List<WebShop.Core.Entities.CartItem>())
                            {
                                <tr>
                                    <td class="image product-thumbnail">
                                        <img src="~/assets/imgs/shop/@item.Product.ImageUrl" alt="@item.Product.ProductName">
                                    </td>
                                    <td>
                                        <h6 class="w-160 mb-5">
                                            <a href="shop-product-full.html" class="text-heading">@item.Product.ProductName</a>
                                        </h6>
                                    </td>
                                    <td>
                                        <h6 class="text-muted pl-20 pr-20">x @item.Quantity</h6>
                                    </td>
                                    <td>
                                        <h4 class="text-brand">@((item.Quantity * item.Product.Price).ToString("C"))</h4>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Order Totals -->
                <div class="divider-2 mt-30 mb-30"></div>
                <table class="table no-border">
                    <tbody>
                        <tr>
                            <td>
                                <h6 class="text-muted">Subtotal</h6>
                            </td>
                            <td class="text-end">
                                <h4 class="text-brand">@ViewBag.Subtotal?.ToString("C")</h4>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <h6 class="text-muted">Shipping</h6>
                            </td>
                            <td class="text-end">
                                <h6 class="text-heading">Free</h6>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <div class="divider-2 mt-10 mb-10"></div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <h6 class="text-muted">Total</h6>
                            </td>
                            <td class="text-end">
                                <h4 class="text-brand">@Model.OrderTotal.ToString("C")</h4>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Payment Section -->
            <div class="payment ml-30">
                <h4 class="mb-30">Payment</h4>
                <div class="payment_option">
                    <div class="custome-radio">
                        <input class="form-check-input" required="" type="radio" name="payment_option" id="exampleRadios3" checked="" disabled>
                        <label class="form-check-label" for="exampleRadios3" data-bs-toggle="collapse" data-target="#bankTranfer" aria-controls="bankTranfer">Direct Bank Transfer</label>
                    </div>
                    <div class="custome-radio">
                        <input class="form-check-input" required="" type="radio" name="payment_option" id="exampleRadios5" checked="" disabled>
                        <label class="form-check-label" for="exampleRadios5" data-bs-toggle="collapse" data-target="#paypal" aria-controls="paypal">Online Getway</label>
                    </div>
                    <div class="custome-radio">
                        <input class="form-check-input" required="" type="radio" name="payment_option" id="exampleRadios4" checked="">
                        <label class="form-check-label" for="exampleRadios4" data-bs-toggle="collapse" data-target="#checkPayment" aria-controls="checkPayment">Cash on delivery</label>
                    </div>
                </div>
                <div class="payment-logo d-flex">
                    <img class="mr-15" src="~/assets/imgs/theme/icons/payment-paypal.svg" alt="">
                    <img class="mr-15" src="~/assets/imgs/theme/icons/payment-visa.svg" alt="">
                    <img class="mr-15" src="~/assets/imgs/theme/icons/payment-master.svg" alt="">
                    <img src="~/assets/imgs/theme/icons/payment-zapper.svg" alt="">
                </div>

                <!-- Complete Order Button -->
                <button type="submit" form="checkoutForm" class="btn btn-fill-out btn-block mt-30">
                    Place an Order<i class="fi-rs-sign-out ml-15"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/checkout.js"></script>
}
