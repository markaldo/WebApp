@model WebShop.Core.Entities.Order
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container mb-80 mt-50">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            <div class="icon-box iconbox-border-color-success">
                <div class="icon-box-img">
                    <i class="fi-rs-check-circle text-success"></i>
                </div>
                <h3 class="mt-10 mb-20">Order Confirmed!</h3>
                <p class="text-muted mb-30">Thank you for your order. Your purchase has been successfully placed.</p>
            </div>

            <div class="border p-40 border-radius-15 mb-30">
                <h4 class="mb-20">Order Details</h4>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Order Number:</strong> BC-<span id="orderNumber">@Model.Id</span></p>
                        <p><strong>Order Date:</strong> <span id="orderDate">@Model.OrderDate.ToString("dd MMM yyyy HH:mm")</span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Total Amount:</strong> <span id="totalAmount">@Model.TotalPrice.ToString("C")</span></p>
                        <p><strong>Payment Status:</strong> <span class="text-success">Pending</span></p>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <a asp-action="Index" asp-controller="Home" class="btn w-100 mb-10">
                        <i class="fi-rs-shopping-bag mr-10"></i> Continue Shopping
                    </a>
                </div>
                <div class="col-md-6">
                    <a asp-action="Invoice" asp-controller="Shop" asp-route-orderId="@Model.Id"
                       class="btn mb-10 w-100" target="_blank">
                        <i class="fi-rs-download mr-10"></i> Download Invoice
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

